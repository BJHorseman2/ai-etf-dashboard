    {
      "id": "fake-invoice-scam-content",
      "label": "Fake Geek Squad / Windows Defender invoice scam (content match)",
      "from_domain_in": [
        "gmail.com",
        "googlemail.com",
        "outlook.com",
        "hotmail.com",
        "live.com",
        "yahoo.com",
        "icloud.com",
        "me.com",
        "proton.me",
        "protonmail.com",
        "aol.com"
      ],
      "body_contains_all": [
        "billing summary",
        "help desk",
        "did not authorize"
      ],
      "body_contains_any": [
        "geek squad",
        "windows defender",
        "norton",
        "mcafee",
        "best buy",
        "paypal"
      ]
    },
    {
      "id": "fake-receipt-scam-content-v2",
      "label": "Fake security-subscription receipt scam (content match v2)",
      "from_domain_in": [
        "gmail.com",
        "googlemail.com",
        "outlook.com",
        "hotmail.com",
        "live.com",
        "yahoo.com",
        "icloud.com",
        "me.com",
        "proton.me",
        "protonmail.com",
        "aol.com"
      ],
      "body_contains_any_groups": [
        [
          "geek squad",
          "geeksquad",
          "mcafee",
          "norton",
          "windows defender",
          "avast",
          "kaspersky",
          "webroot",
          "lifelock",
          "best buy"
        ],
        [
          "invoice id",
          "invoice #",
          "invoice no",
          "order id",
          "order no",
          "transaction id",
          "subscription renewal",
          "renewal date",
          "license key"
        ],
        [
          "hours to",
          "help desk",
          "customer support",
          "customer service",
          "connect with us",
          "call us",
          "reach out",
          "tech support"
        ]
      ],
      "body_regex": "\\+\\s?1\\s*[\\(\\-]?\\s*\\d{3}\\s*[\\)\\-]?\\s*\\d{3}\\s*[\\-\\s]?\\s*\\d{4}"
    },
    {
      "id": "geeksquad-scam-4",
      "label": "Fake invoice scam (Philip M. Lawson)",
      "from_email": "willsmith78545@gmail.com"
    },
    {
      "id": "fake-invoice-pdf-named-for-account",
      "label": "Fake invoice scam (PDF named after this mailbox, empty body)",
      "from_domain_in": [
        "gmail.com",
        "googlemail.com",
        "outlook.com",
        "hotmail.com",
        "live.com",
        "yahoo.com",
        "icloud.com",
        "me.com",
        "proton.me",
        "protonmail.com",
        "aol.com"
      ],
      "attachment_types_any": [
        "application/pdf"
      ],
      "attachment_name_regex": "^\\d{8}_{account_local}_[A-Za-z0-9-]+\\.pdf$",
      "max_text_chars": 100
    },
    {
      "id": "fake-invoice-pdf-order-subject",
      "label": "Fake invoice scam (\"Thank You for Your Order\" + PDF, empty body)",
      "from_domain_in": [
        "gmail.com",
        "googlemail.com",
        "outlook.com",
        "hotmail.com",
        "live.com",
        "yahoo.com",
        "icloud.com",
        "me.com",
        "proton.me",
        "protonmail.com",
        "aol.com"
      ],
      "subject_regex": "^\\s*(re:\\s*)?thank you for your order\\s+[A-Z0-9]{10,}\\s*$",
      "attachment_types_any": [
        "application/pdf"
      ],
      "max_text_chars": 60
    },
