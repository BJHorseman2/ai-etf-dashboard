# ── Expense Tracker configuration ──────────────────────────────────────────
# Copy this file to .env and fill in values. NEVER commit your real .env.

# Port the server listens on
PORT=3000

# REQUIRED in production: 64 hex chars (32 bytes) used to encrypt bank access
# tokens at rest (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is derived and stored in data/.local-key (dev convenience).
ENCRYPTION_KEY=

# ── Plaid (real bank/card linking) ──────────────────────────────────────────
# Get free sandbox + development keys at https://dashboard.plaid.com
# Leave blank to run in DEMO MODE with realistic sample data.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox

# Set to "true" when serving over HTTPS (marks session cookies Secure)
SECURE_COOKIES=false
